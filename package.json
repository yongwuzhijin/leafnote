{
  "name": "leafnote",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/main/index.cjs",
  "author": "LeafNote contributors",
  "description": "叶笺 LeafNote，macOS 上的离线 Markdown 编辑器",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "vite build && node scripts/build-electron.mjs",
    "package:mac": "pnpm run build && pnpm exec electron-builder --mac --arm64 && pnpm exec electron-builder --mac --x64",
    "start": "pnpm run build && electron ."
  },
  "dependencies": {
    "@sanity/diff-match-patch": "3.2.1",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-code": "3.31.3",
    "@tiptap/extension-code-block": "3.31.3",
    "@tiptap/extension-code-block-lowlight": "3.31.3",
    "@tiptap/extension-details": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-mathematics": "3.31.3",
    "@tiptap/extension-paragraph": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-table-cell": "3.31.3",
    "@tiptap/extension-table-header": "3.31.3",
    "@tiptap/extension-table-row": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "diff": "8.0.4",
    "dompurify": "3.4.16",
    "electron": "43.7.5",
    "highlight.js": "11.11.2",
    "jsdom": "31.0.1",
    "katex": "0.16.47",
    "lowlight": "3.3.0",
    "marked": "17.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "remark-breaks": "4.0.0",
    "remark-cjk-friendly": "2.3.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "electron-winstaller"
    ]
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "happy-dom": "20.14.5",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vitest": "5.0.3"
  }
}
